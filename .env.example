# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this key to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://inventory.allautomationmodules.com

# AI (server-only). Groq free key recommended: https://console.groq.com
# Leave empty to use rule-based inventory answers only.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Telegram phone alerts (optional). Token from @BotFather. You can also paste it in Settings.
TELEGRAM_BOT_TOKEN=
